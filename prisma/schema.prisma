// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  PG_OWNER
  USER
}

enum UserType {
  STUDENT
  TOURIST
  WORKING_PROFESSIONAL
  EMPLOYEE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String?
  email           String    @unique
  phone           String    @unique
  password        String
  role            UserRole
  userType        UserType?
  gender          Gender?
  dateOfBirth     DateTime? @db.Date
  profileImage    String?
  country         String?
  state           String?
  city            String?
  address         String?
  pincode         String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pg        Pg?
  residents Resident[]
}

/// One PG per owner, created with the owner during registration.
enum PgGender {
  BOYS
  GIRLS
  CO_LIVING
}

enum Cooling {
  AC
  NON_AC
  BOTH
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  PREMIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Pg {
  id           String             @id @default(cuid())
  /// Short, shareable code an owner can quote (e.g. PZ-4F7K2A).
  pgCode       String             @unique
  name         String
  location     String
  city         String?
  description  String?
  /// Starting monthly rent, in rupees.
  price        Int?
  deposit      Int?
  gender       PgGender?
  cooling      Cooling?
  foodIncluded Boolean            @default(false)
  foodDetails  String?
  /// Square brand mark for the PG, shown on listing cards and the dashboard.
  logo         String?
  /// Matches the string list the website already models.
  amenities    String[]           @default([])
  images       String[]           @default([])
  /// Set by a Super Admin only; never writable by the owner.
  verification VerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  /// Aggregates maintained by the ratings feature; read-only here.
  rating       Float              @default(0)
  reviewCount  Int                @default(0)
  ownerId      String             @unique
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roomTypes    PgRoomType[]
  residents    Resident[]
  rooms        Room[]
  payments     Payment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// One row per room type per PG, carrying its own pricing and availability.
model PgRoomType {
  id            String   @id @default(cuid())
  pgId          String
  pg            Pg       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  type          RoomType
  pricePerBed   Int
  /// Four fixed photo slots per room type: two of the room itself, one of the
  /// bathroom, one of anything else. Nullable so existing rows stay valid; the
  /// API requires all four before a room type may be offered.
  roomImage1    String?
  roomImage2    String?
  bathroomImage String?
  otherImage    String?
  rooms         Room[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([pgId, type])
}

enum ResidentStatus {
  ACTIVE
  LEFT
}

/// Someone staying in a PG. Free beds are counted from the ACTIVE rows here.
model Resident {
  id          String            @id @default(cuid())
  pgId        String
  pg          Pg                @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// Linked Pzee account when the guest is registered; null for a walk-in.
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName    String
  phone       String
  address     String?
  gender      Gender?
  /// Reuses the type a Find-PG user already chose when registering.
  userType    UserType?
  /// The sharing type, kept for pricing and listing.
  roomType    RoomType
  /// The actual room they were given.
  roomId      String?
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  monthlyRent Int
  joinedAt    DateTime          @default(now())
  dueDate     DateTime?
  leftAt      DateTime?
  status      ResidentStatus    @default(ACTIVE)
  payments    Payment[]
  services    ResidentService[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([pgId, status])
}

/// One rent transaction. The guest's last payment date is derived from these.
model Payment {
  id         String    @id @default(cuid())
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  /// Denormalised so a PG total can be summed without joining residents.
  pgId       String
  pg         Pg        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  amount     Int
  paidOn     DateTime  @default(now())
  /// The rent month this covers, stored as the first of that month.
  forMonth   DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([pgId, paidOn])
}

/// A physical room. Beds and occupancy are counted from these, not typed in.
model Room {
  id        String     @id @default(cuid())
  pgId      String
  pg        Pg         @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// What the owner calls it: 201, G-4, and so on.
  number    String
  type      RoomType
  roomType  PgRoomType @relation(fields: [pgId, type], references: [pgId, type], onDelete: Cascade)
  floor     String?
  /// Defaults to the beds that sharing type holds, editable for odd rooms.
  totalBeds Int
  residents Resident[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([pgId, number])
  @@index([pgId, type])
}

/// A service a resident takes, such as food or laundry, billed monthly.
model ResidentService {
  id            String   @id @default(cuid())
  residentId    String
  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  /// Matches one of the PG amenities.
  name          String
  monthlyAmount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([residentId, name])
}
