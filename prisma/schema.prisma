// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  PG_OWNER
  USER
}

enum UserType {
  STUDENT
  TOURIST
  WORKING_PROFESSIONAL
  EMPLOYEE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String?
  email           String    @unique
  phone           String    @unique
  password        String
  role            UserRole
  userType        UserType?
  gender          Gender?
  dateOfBirth     DateTime? @db.Date
  profileImage    String?
  country         String?
  state           String?
  city            String?
  address         String?
  pincode         String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  /// Shareable code a customer gives a PG owner, e.g. PZR-4F7K2A. Only
  /// customers get one; owners and admins have none.
  referralCode    String?   @unique
  /// Set when the account is closed. The row is purged 30 days later, which is
  /// the window in which a Super Admin can still restore it.
  deletedAt       DateTime?
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pg              Pg?
  residents       Resident[]
  visitRequests   VisitRequest[]
  /// PGs that named this customer's referral code when they registered.
  referredPgs     Pg[]              @relation("PgReferrer")
  /// ₹100 credited to this customer each time a referred PG goes live.
  referralRewards ReferralReward[]
  /// Listing fees this Super Admin has confirmed receipt of.
  confirmedFees   PlatformPayment[] @relation("PlatformPaymentConfirmedBy")

  /// The purge job scans for closed accounts past their window every day.
  @@index([deletedAt])
}

/// One PG per owner, created with the owner during registration.
enum PgGender {
  BOYS
  GIRLS
  CO_LIVING
}

enum Cooling {
  AC
  NON_AC
  BOTH
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  PREMIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Whether the ₹100 listing fee has been received.
enum PlatformPaymentStatus {
  PENDING
  PAID
}

model Pg {
  id           String             @id @default(cuid())
  /// Short, shareable code an owner can quote (e.g. PZ-4F7K2A).
  pgCode       String             @unique
  name         String
  location     String
  city         String?
  description  String?
  /// Starting monthly rent, in rupees.
  price        Int?
  deposit      Int?
  gender       PgGender?
  cooling      Cooling?
  foodIncluded Boolean            @default(false)
  foodDetails  String?
  /// Square brand mark for the PG, shown on listing cards and the dashboard.
  logo         String?
  /// Matches the string list the website already models.
  amenities    String[]           @default([])
  images       String[]           @default([])
  /// A new PG is private until the ₹100 listing fee is confirmed. Existing PGs
  /// were published by the migration so nothing already live went dark.
  isPublished  Boolean            @default(false)
  publishedAt  DateTime?
  /// The customer whose referral code the owner gave at registration.
  referredById String?
  referredBy   User?              @relation("PgReferrer", fields: [referredById], references: [id], onDelete: SetNull)
  /// Set by a Super Admin only; never writable by the owner.
  verification VerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  /// Aggregates maintained by the ratings feature; read-only here.
  rating       Float              @default(0)
  reviewCount  Int                @default(0)
  ownerId      String             @unique
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roomTypes    PgRoomType[]
  residents    Resident[]
  visits       VisitRequest[]
  rooms        Room[]
  payments     Payment[]
  /// The one-off ₹100 that makes this PG public.
  listingFee     PlatformPayment?
  /// The ₹100 credited to the referring customer once that fee is confirmed.
  referralReward ReferralReward?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/**
 * The one-off ₹100 a PG owner pays the platform to make their listing public.
 *
 * There is no payment gateway yet, so the owner pays by UPI and a Super Admin
 * confirms receipt. That confirmation is the single place the PG goes live and
 * the referral reward is credited, which is exactly where a Razorpay webhook
 * will attach later without any of this being rebuilt.
 */
model PlatformPayment {
  id            String                @id @default(cuid())
  /// One fee per PG, so it can never be charged or confirmed twice.
  pgId          String                @unique
  pg            Pg                    @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// Rupees, matching how every other amount in this schema is stored.
  amount        Int
  status        PlatformPaymentStatus @default(PENDING)
  /// UPI reference the owner quotes, so the admin can match the transfer.
  reference     String?
  paidAt        DateTime?
  confirmedById String?
  confirmedBy   User?                 @relation("PlatformPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
}

/**
 * ₹100 credited to the customer who referred a PG, once that PG's listing fee
 * is confirmed. One per PG: the unique key is what stops a double payout.
 */
model ReferralReward {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pgId       String   @unique
  pg         Pg       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  amount     Int
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// One row per room type per PG, carrying its own pricing and availability.
model PgRoomType {
  id            String   @id @default(cuid())
  pgId          String
  pg            Pg       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  type          RoomType
  pricePerBed   Int
  /// Four fixed photo slots per room type: two of the room itself, one of the
  /// bathroom, one of anything else. Nullable so existing rows stay valid; the
  /// API requires all four before a room type may be offered.
  roomImage1    String?
  roomImage2    String?
  bathroomImage String?
  otherImage    String?
  rooms         Room[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([pgId, type])
}

enum ResidentStatus {
  ACTIVE
  LEFT
}

/// Someone staying in a PG. Free beds are counted from the ACTIVE rows here.
model Resident {
  id          String            @id @default(cuid())
  pgId        String
  pg          Pg                @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// Linked Pzee account when the guest is registered; null for a walk-in.
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName    String
  phone       String
  address     String?
  gender      Gender?
  /// Reuses the type a Find-PG user already chose when registering.
  userType    UserType?
  /// The sharing type, kept for pricing and listing.
  roomType    RoomType
  /// The actual room they were given.
  roomId      String?
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  monthlyRent Int
  joinedAt    DateTime          @default(now())
  dueDate     DateTime?
  leftAt      DateTime?
  status      ResidentStatus    @default(ACTIVE)
  payments    Payment[]
  services    ResidentService[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([pgId, status])
}

/// One rent transaction. The guest's last payment date is derived from these.
model Payment {
  id         String    @id @default(cuid())
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  /// Denormalised so a PG total can be summed without joining residents.
  pgId       String
  pg         Pg        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  amount     Int
  paidOn     DateTime  @default(now())
  /// The rent month this covers, stored as the first of that month.
  forMonth   DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([pgId, paidOn])
}

/// A physical room. Beds and occupancy are counted from these, not typed in.
model Room {
  id        String     @id @default(cuid())
  pgId      String
  pg        Pg         @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// What the owner calls it: 201, G-4, and so on.
  number    String
  type      RoomType
  roomType  PgRoomType @relation(fields: [pgId, type], references: [pgId, type], onDelete: Cascade)
  floor     String?
  /// Defaults to the beds that sharing type holds, editable for odd rooms.
  totalBeds Int
  residents Resident[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([pgId, number])
  @@index([pgId, type])
}

/// A service a resident takes, such as food or laundry, billed monthly.
model ResidentService {
  id            String   @id @default(cuid())
  residentId    String
  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  /// Matches one of the PG amenities.
  name          String
  monthlyAmount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([residentId, name])
}

enum VisitStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// A signed-in customer asking to see a PG. The owner works through these.
model VisitRequest {
  id            String      @id @default(cuid())
  pgId          String
  pg            Pg          @relation(fields: [pgId], references: [id], onDelete: Cascade)
  /// Booking requires an account, so the owner always gets real contact details.
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Copied at the time of booking, so the owner keeps what was sent.
  fullName      String
  phone         String
  email         String
  preferredDate DateTime?
  message       String?
  status        VisitStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([pgId, status])
}
