# Example local configuration. Copy this file to .env and change values as needed.
HOST=127.0.0.1
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed to send the session cookie.
# Leave empty locally to reflect the requesting origin.
CORS_ORIGINS=

# Session cookie. Set AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAME_SITE=none in
# production, where the site and the API are served from different domains.
AUTH_COOKIE_NAME=pzee_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
