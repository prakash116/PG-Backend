# Example local configuration. Copy this file to .env and change values as needed.
HOST=127.0.0.1
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed to send the session cookie.
# Leave empty locally to reflect the requesting origin.
CORS_ORIGINS=

# Session cookie. Set AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAME_SITE=none in
# production, where the site and the API are served from different domains.
AUTH_COOKIE_NAME=pzee_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Postgres connection used by the Prisma client at runtime (pooled connection).
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Direct (non-pooled) connection used by Prisma CLI migrations. See prisma.config.ts.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Connection pool. All optional — the defaults are tuned for the Supabase pooler
# and are what you want unless you have measured otherwise.
#
# Opening a connection to the pooler was measured at 2.2s-12.9s from this
# project; reusing an open one answers in under a second. So the pool holds
# connections open through the pauses in ordinary use (DB_IDLE_TIMEOUT_MS) and
# allows a slow handshake to finish (DB_CONNECTION_TIMEOUT_MS) instead of
# abandoning it and returning a 500.
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=600000
# DB_POOL_MAX=5

# Absolute public base URL for links this API returns (uploaded images).
# Defaults to http://HOST:PORT when unset.
PUBLIC_BASE_URL=

# Optional. When all three are set, profile photos go to Cloudinary instead
# of local disk. Required for production, where the filesystem is ephemeral.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# production turns on strict CORS, hides Swagger, and binds 0.0.0.0.
NODE_ENV=development

# Publishes /api/docs when NODE_ENV=production. Leave off unless needed.
ENABLE_SWAGGER=
