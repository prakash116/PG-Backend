# Example local configuration. Copy this file to .env and change values as needed.
HOST=127.0.0.1
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed to send the session cookie.
# Leave empty locally to reflect the requesting origin.
CORS_ORIGINS=

# Session cookie. Set AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAME_SITE=none in
# production, where the site and the API are served from different domains.
AUTH_COOKIE_NAME=pzee_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Postgres connection used by the Prisma client at runtime (pooled connection).
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Direct (non-pooled) connection used by Prisma CLI migrations. See prisma.config.ts.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Connection pool. All optional — the defaults are tuned for the Supabase pooler
# and are what you want unless you have measured otherwise.
#
# Opening a connection to the pooler was measured at 2.2s-12.9s from this
# project; reusing an open one answers in under a second. So the pool holds
# connections open through the pauses in ordinary use (DB_IDLE_TIMEOUT_MS) and
# allows a slow handshake to finish (DB_CONNECTION_TIMEOUT_MS) instead of
# abandoning it and returning a 500.
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=600000
# DB_POOL_MAX=5

# Absolute public base URL for links this API returns (uploaded images).
# Defaults to http://HOST:PORT when unset.
PUBLIC_BASE_URL=

# Optional. When all three are set, profile photos go to Cloudinary instead
# of local disk. Required for production, where the filesystem is ephemeral.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# production turns on strict CORS, hides Swagger, and binds 0.0.0.0.
NODE_ENV=development

# Publishes /api/docs when NODE_ENV=production. Leave off unless needed.
ENABLE_SWAGGER=

# --- Listing fee and referral reward -----------------------------------------
# The one-off fee a PG owner pays to make their listing public, and the reward
# credited to the customer whose referral code they gave. Both in rupees; both
# default to 100 when unset, so leaving them out changes nothing.
LISTING_FEE_RUPEES=100
REFERRAL_REWARD_RUPEES=100
# Where owners send that fee. Left blank the API says "not set up yet" rather
# than showing a placeholder somebody might actually pay money to.
SUPER_ADMIN_UPI_ID=

# --- Email (SMTP) --------------------------------------------------------
# The account Pzee sends verification codes from. A Super Admin can change
# these from the dashboard afterwards; the stored settings win over these.
# For Gmail this must be an App Password, not the account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Pzee
# How long a six-digit code lasts, and how many wrong guesses burn it.
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- SMS OTP (MSG91 widget) ----------------------------------------------
# Starting values only; a Super Admin can change them from the dashboard and
# the stored settings win. From MSG91 dashboard -> OTP -> your widget ->
# Integration. widgetId and tokenAuth are client-side values by MSG91's
# design; the authkey is server-side only and must stay secret.
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_AUTH_KEY=
